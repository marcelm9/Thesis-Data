```c
#define COMPILERFLAGS "-lm -fopenmp"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array
  for (long long i = 0; i < vector_size; i++) {
    arr[i] = rand() % 100; // random values in [0, 99]
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // compute prefix sum (parallelized with OpenMP Scan)
  // This is a common pattern for prefix sums (Blelloch scan)
  // For small vector_size, a sequential approach might be faster due to overhead.
  // For large vector_size, this parallel approach can offer significant speedup.

  // Step 1: Compute partial sums in parallel
  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    int nthreads = omp_get_num_threads();
    long long start_idx = (vector_size / nthreads) * tid;
    long long end_idx = (tid == nthreads - 1) ? vector_size : (vector_size / nthreads) * (tid + 1);

    if (start_idx < end_idx) {
        prefixSum[start_idx] = arr[start_idx];
        for (long long i = start_idx + 1; i < end_idx; i++) {
            prefixSum[i] = prefixSum[i - 1] + arr[i];
        }
    }
  }

  // Step 2: Compute offsets and add them to partial sums
  // This part is inherently sequential or requires more complex parallel algorithms (like Blelloch scan)
  // For simplicity and understanding OpenMP, we'll keep the offset calculation somewhat sequential
  // as the "scan" operation is not a direct OpenMP construct like "for".

  long long *block_sums = NULL;
  int num_threads = omp_get_max_threads(); // Max threads available to allocate block_sums
  if (num_threads > 0) { // Safety check
    block_sums = (long long*) malloc(num_threads * sizeof(long long));
    if (!block_sums) {
        printf("Memory allocation for block_sums failed\n");
        exit(1); // Exit if critical allocation fails
    }
  }


  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    int nthreads = omp_get_num_threads();
    long long end_idx = (tid == nthreads - 1) ? vector_size : (vector_size / nthreads) * (tid + 1);
    
    if (end_idx > 0 && nthreads > 0 && tid < nthreads) {
        block_sums[tid] = prefixSum[end_idx - 1]; // Store the last prefix sum of each block
    }
  }

  // Compute cumulative sums of block_sums (sequential part)
  for (int i = 1; i < num_threads; i++) {
    block_sums[i] += block_sums[i-1];
  }

  // Add the block_sums (offsets) to the corresponding prefixSum blocks in parallel
  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    int nthreads = omp_get_num_threads();
    long long start_idx = (vector_size / nthreads) * tid;
    long long end_idx = (tid == nthreads - 1) ? vector_size : (vector_size / nthreads) * (tid + 1);

    long long offset = (tid == 0) ? 0 : block_sums[tid - 1];

    for (long long i = start_idx; i < end_idx; i++) {
      prefixSum[i] += offset;
    }
  }

  free(block_sums); // Free the temporary array


  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  for (long long i = 0; i < vector_size; i++) {
    last_value += arr[i];
    if (prefixSum[i] != last_value) {
      err++;
    }
  }
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
```