#define COMPILERFLAGS "-lm -fopenmp"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array
  for (long long i = 0; i < vector_size; i++) {
    arr[i] = rand() % 100; // random values in [0, 99]
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // compute prefix sum in parallel
  int nthreads = 0;
  long long *sums = NULL;
  long long *offsets = NULL;

#pragma omp parallel
  {
#pragma omp single
    {
      nthreads = omp_get_num_threads();
      sums = (long long *)malloc(nthreads * sizeof(long long));
      offsets = (long long *)malloc((nthreads + 1) * sizeof(long long));
      if (!sums || !offsets) {
        printf("Memory allocation for parallel prefix failed\n");
        exit(1);
      }
    }

    int tid = omp_get_thread_num();
    long long chunk_size = vector_size / nthreads;
    long long start_idx = tid * chunk_size;
    long long end_idx = (tid == nthreads - 1) ? vector_size : start_idx + chunk_size;

    long long local_sum = 0;
    for (long long i = start_idx; i < end_idx; i++) {
      local_sum += arr[i];
      prefixSum[i] = local_sum;
    }
    sums[tid] = local_sum;

#pragma omp barrier

#pragma omp single
    {
      offsets[0] = 0;
      for (int i = 1; i < nthreads; i++) {
        offsets[i] = offsets[i-1] + sums[i-1];
      }
    }

    for (long long i = start_idx; i < end_idx; i++) {
      prefixSum[i] += offsets[tid];
    }
  }
  free(sums);
  free(offsets);

  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  for (long long i = 0; i < vector_size; i++) {
    last_value += arr[i];
    if (prefixSum[i] != last_value) {
      err++;
    }
  }
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
