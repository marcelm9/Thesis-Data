```c
#define COMPILERFLAGS "-lm -fopenmp"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array (can be parallelized)
  #pragma omp parallel for
  for (long long i = 0; i < vector_size; i++) {
    // To ensure deterministic behavior, we can't parallelize random generation directly
    // Each thread needs to generate its own values
    int local_rand = rand_r(&(unsigned int){seed + i}) % 100;
    arr[i] = local_rand; // random values in [0, 99]
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // compute prefix sum - this is a scan operation
  prefixSum[0] = arr[0];
  
  // Parallel scan algorithm
  // Note: This is a simple parallelization that may not be optimal for all cases
  #pragma omp parallel
  {
    // First compute local sums in chunks
    #pragma omp for
    for (long long i = 1; i < vector_size; i++) {
      prefixSum[i] = arr[i];
    }
    
    // Scan with doubling step size
    for (long long d = 1; d < vector_size; d *= 2) {
      #pragma omp barrier
      #pragma omp for
      for (long long i = d; i < vector_size; i++) {
        prefixSum[i] += prefixSum[i - d];
      }
    }
  }

  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  for (long long i = 0; i < vector_size; i++) {
    last_value += arr[i];
    if (prefixSum[i] != last_value) {
      err++;
    }
  }
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
```