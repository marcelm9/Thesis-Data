#define COMPILERFLAGS "-lm -fopenmp"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array
  #pragma omp parallel
  {
    unsigned int thread_seed = (unsigned int)(seed + omp_get_thread_num());
    #pragma omp for
    for (long long i = 0; i < vector_size; i++) {
      // Make each thread use its own rng to avoid race conditions
      arr[i] = rand_r(&thread_seed) % 100;
    }
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // Parallel prefix sum (Blelloch scan, inclusive)
  int num_threads;
  long long *thread_sums = NULL;
  long long *offsets = NULL;
  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    int nth = omp_get_num_threads();
    #pragma omp single
    {
      num_threads = nth;
      thread_sums = (long long*)calloc(num_threads, sizeof(long long));
      offsets = (long long*)calloc(num_threads, sizeof(long long));
    }
    #pragma omp barrier

    // Compute private partial prefix sums in each thread's chunk
    long long chunk = vector_size / num_threads;
    long long start_idx = tid * chunk;
    long long end_idx = (tid == num_threads - 1) ? vector_size : (tid + 1) * chunk;
    if (start_idx < end_idx) {
      prefixSum[start_idx] = arr[start_idx];
      for (long long i = start_idx + 1; i < end_idx; i++) {
        prefixSum[i] = prefixSum[i - 1] + arr[i];
      }
      thread_sums[tid] = prefixSum[end_idx - 1];
    }

    #pragma omp barrier

    // Compute offsets for each thread
    #pragma omp single
    {
      for (int i = 1; i < num_threads; i++) {
        offsets[i] = offsets[i - 1] + thread_sums[i - 1];
      }
    }
    #pragma omp barrier

    // Add offset to each thread's results except thread 0
    if (tid > 0 && start_idx < end_idx) {
      for (long long i = start_idx; i < end_idx; i++) {
        prefixSum[i] += offsets[tid];
      }
    }
  }

  free(thread_sums);
  free(offsets);

  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  for (long long i = 0; i < vector_size; i++) {
    last_value += arr[i];
    if (prefixSum[i] != last_value) {
      err++;
    }
  }
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
