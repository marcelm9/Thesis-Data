#define COMPILERFLAGS "-lm -fopenmp"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array
  #pragma omp parallel for
  for (long long i = 0; i < vector_size; i++) {
    arr[i] = rand() % 100; // random values in [0, 99]
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // compute prefix sum in two phases for parallelism
  // phase 1: local prefix sums in chunks
  long long chunk_size = vector_size / omp_get_max_threads();
  if (chunk_size == 0) chunk_size = vector_size;
  long long *temp = malloc(omp_get_max_threads() * sizeof(long long));

  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    int num_threads = omp_get_num_threads();
    long long start_idx = tid * chunk_size;
    long long end_idx = (tid == num_threads - 1) ? vector_size : start_idx + chunk_size;

    if (start_idx < vector_size) {
      prefixSum[start_idx] = arr[start_idx];
      for (long long i = start_idx + 1; i < end_idx; i++) {
        prefixSum[i] = prefixSum[i - 1] + arr[i];
      }
      if (end_idx > start_idx) {
        temp[tid] = prefixSum[end_idx - 1];
      } else {
        temp[tid] = 0;
      }
    }
  }

  // phase 2: adjust prefix sums based on cumulative sums of previous chunks
  long long cumsum = 0;
  for (int t = 0; t < omp_get_max_threads(); t++) {
    long long temp_val = temp[t];
    temp[t] = cumsum;
    cumsum += temp_val;
  }

  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    int num_threads = omp_get_num_threads();
    long long start_idx = tid * chunk_size;
    long long end_idx = (tid == num_threads - 1) ? vector_size : start_idx + chunk_size;
    long long offset = temp[tid];

    for (long long i = start_idx; i < end_idx; i++) {
      prefixSum[i] += offset;
    }
  }

  free(temp);

  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  for (long long i = 0; i < vector_size; i++) {
    last_value += arr[i];
    if (prefixSum[i] != last_value) {
      err++;
    }
  }
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
