```c
#define COMPILERFLAGS "-lm -fopenmp"

#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

#define TOL 0.00001
#define K 3

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <image_size> <seed>\n", argv[0]);
    return 1;
  }

  long N = strtol(argv[1], NULL, 10);
  if (N <= 2) {
    printf("Image size must be greater than 2\n");
    return 1;
  }

  srand((unsigned int)strtol(argv[2], NULL, 10));

  // allocate memory for image and output
  float **image = malloc(N * sizeof(float *));
  float **output = malloc(N * sizeof(float *));
  float **reference = malloc(N * sizeof(float *));

  // Use OpenMP for parallel allocation of inner arrays if N is large
  // This might not be strictly necessary for typical N, but demonstrates parallel allocation.
  #pragma omp parallel for
  for (int i = 0; i < N; i++) {
    image[i] = malloc(N * sizeof(float));
    output[i] = malloc(N * sizeof(float));
    reference[i] = malloc(N * sizeof(float));
  }

  if (!image || !output || !reference) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // Check if any of the inner allocations failed.
  // This check can be done serially or in parallel, but serial is simpler for error handling.
  for (int i = 0; i < N; i++) {
      if (!image[i] || !output[i] || !reference[i]) {
          printf("Memory allocation failed for row %d\n", i);
          return 1;
      }
  }

  // define 3x3 Gaussian kernel
  float kernel[K][K] = {{1 / 16.0, 2 / 16.0, 1 / 16.0},
                        {2 / 16.0, 4 / 16.0, 2 / 16.0},
                        {1 / 16.0, 2 / 16.0, 1 / 16.0}};

  // initialize image with values based on random multiplier
  int multiplier = rand() % 1000;
  #pragma omp parallel for collapse(2)
  for (int i = 0; i < N; i++)
    for (int j = 0; j < N; j++)
      image[i][j] = (float)(i + j) * multiplier / N;

  // compute reference output for validation
  // This loop can also be parallelized, but it's not part of the timed section.
  #pragma omp parallel for collapse(2)
  for (int i = 1; i < N - 1; i++) {
    for (int j = 1; j < N - 1; j++) {
      float sum = 0.0;
      for (int ki = 0; ki < K; ki++)
        for (int kj = 0; kj < K; kj++)
          sum += kernel[ki][kj] * image[i + ki - 1][j + kj - 1];
      reference[i][j] = sum;
    }
  }

  // start timing
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // apply Gaussian blur
  // Parallelize the outer loops of the convolution operation
  #pragma omp parallel for collapse(2)
  for (int i = 1; i < N - 1; i++) {
    for (int j = 1; j < N - 1; j++) {
      float sum = 0.0;
      for (int ki = 0; ki < K; ki++)
        for (int kj = 0; kj < K; kj++)
          sum += kernel[ki][kj] * image[i + ki - 1][j + kj - 1];
      output[i][j] = sum;
    }
  }

  // stop timing
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // check results
  int errors = 0;
  // Use a reduction for 'errors' if checking in parallel, but summing up errors
  // after the parallel region is also fine and often simpler.
  // We can parallelize the loop and use a local error count which is then reduced.
  int local_errors = 0;
  #pragma omp parallel reduction(+:errors)
  {
      local_errors = 0; // Initialize for each thread
      #pragma omp for collapse(2)
      for (int i = 1; i < N - 1; i++) {
        for (int j = 1; j < N - 1; j++) {
          if (fabs(output[i][j] - reference[i][j]) > TOL)
            local_errors++;
        }
      }
      errors += local_errors; // This update is atomatically handled by reduction
  }


  // print results
  printf("[%d, %f]\n", errors, runtime);

  // free memory
  #pragma omp parallel for
  for (int i = 0; i < N; i++) {
    free(image[i]);
    free(output[i]);
    free(reference[i]);
  }
  free(image);
  free(output);
  free(reference);

  return 0;
}
```