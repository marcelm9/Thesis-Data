```c
#define COMPILERFLAGS "-lm -fopenmp"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array in parallel
  #pragma omp parallel for
  for (long long i = 0; i < vector_size; i++) {
    unsigned int local_seed = seed + i; // Ensure thread-safe random generation
    arr[i] = rand_r(&local_seed) % 100; // random values in [0, 99]
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // compute prefix sum - this is inherently sequential but we can use parallel scan algorithm
  prefixSum[0] = arr[0];
  
  // Use parallel prefix sum algorithm (work-efficient parallel scan)
  #pragma omp parallel
  {
    // Up-sweep phase (reduction)
    for (int d = 0; d < vector_size; d = 2*d+1) {
      #pragma omp for
      for (long long i = 0; i < vector_size; i += 2*(d+1)) {
        if (i + d < vector_size && i + 2*d + 1 < vector_size) {
          prefixSum[i + 2*d + 1] += prefixSum[i + d];
        }
      }
      #pragma omp barrier
    }

    // Down-sweep phase (distribution)
    for (long long d = vector_size/2; d > 0; d /= 2) {
      #pragma omp for
      for (long long i = d; i < vector_size; i += d) {
        prefixSum[i] = (i % (2*d) == 0) ? 
                       prefixSum[i - d/2] : 
                       prefixSum[i - d/2] + prefixSum[i - d];
      }
      #pragma omp barrier
    }
  }

  // Sequential scan as fallback - comment out the parallel version above to use this instead
  // prefixSum[0] = arr[0];
  // for (long long i = 1; i < vector_size; i++) {
  //   prefixSum[i] = prefixSum[i - 1] + arr[i];
  // }

  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  
  #pragma omp parallel reduction(+:err)
  {
    long long local_last_value = 0;
    #pragma omp for
    for (long long i = 0; i < vector_size; i++) {
      local_last_value += arr[i];
      if (prefixSum[i] != local_last_value) {
        err++;
      }
    }
  }
  
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
```