#define COMPILERFLAGS "-fopenmp -lm"

#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <omp.h>

int main(int argc, char *argv[]) {
  if (argc != 3) {
    printf("Usage: %s <vector_size> <seed>\n", argv[0]);
    return 1;
  }

  // parse vector size
  char *endptr;
  long long vector_size = strtoll(argv[1], &endptr, 10);
  if (*endptr != '\0' || vector_size <= 0) {
    printf("Invalid vector size\n");
    return 1;
  }

  long long seed = strtoll(argv[2], NULL, 10);
  srand((unsigned int)seed);

  // create arrays
  int *arr = malloc(vector_size * sizeof(int));
  long long *prefixSum = malloc(vector_size * sizeof(long long));
  if (!arr || !prefixSum) {
    printf("Memory allocation failed\n");
    return 1;
  }

  // fill the array
  for (long long i = 0; i < vector_size; i++) {
    arr[i] = rand() % 100; // random values in [0, 99]
  }

  // start measuring
  struct timespec start, end;
  clock_gettime(CLOCK_MONOTONIC, &start);

  // compute prefix sum using two-phase OpenMP approach
  int nthreads;
  #pragma omp parallel
  {
    #pragma omp single
    {
      nthreads = omp_get_num_threads();
    }
  }

  long long *chunk_sums = (long long*) malloc(nthreads * sizeof(long long));
  long long *prefix_scans = (long long*) malloc(nthreads * sizeof(long long));
  if (!chunk_sums || !prefix_scans) {
    printf("Memory allocation failed\n");
    free(chunk_sums);
    free(prefix_scans);
    return 1;
  }

  // phase 1: compute local prefix sums
  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    long long chunk_size = (vector_size + nthreads - 1) / nthreads;
    long long start_idx = tid * chunk_size;
    long long end_idx = start_idx + chunk_size;
    if (end_idx > vector_size) {
      end_idx = vector_size;
    }

    long long local_sum = 0;
    for (long long i = start_idx; i < end_idx; i++) {
      local_sum += arr[i];
      prefixSum[i] = local_sum;
    }
    chunk_sums[tid] = local_sum;
  }

  // compute exclusive scan of chunk sums
  prefix_scans[0] = 0;
  for (int t = 1; t < nthreads; t++) {
    prefix_scans[t] = prefix_scans[t - 1] + chunk_sums[t - 1];
  }

  // phase 2: update prefix sums with the offsets
  #pragma omp parallel
  {
    int tid = omp_get_thread_num();
    long long chunk_size = (vector_size + nthreads - 1) / nthreads;
    long long start_idx = tid * chunk_size;
    long long end_idx = start_idx + chunk_size;
    if (end_idx > vector_size) {
      end_idx = vector_size;
    }

    for (long long i = start_idx; i < end_idx; i++) {
      prefixSum[i] += prefix_scans[tid];
    }
  }

  free(chunk_sums);
  free(prefix_scans);

  // end measuring
  clock_gettime(CLOCK_MONOTONIC, &end);
  double runtime = (end.tv_sec - start.tv_sec) +
                   (end.tv_nsec - start.tv_nsec) / 1000000000.0;

  // test results
  int err = 0;
  long long last_value = 0;
  for (long long i = 0; i < vector_size; i++) {
    last_value += arr[i];
    if (prefixSum[i] != last_value) {
      err++;
    }
  }
  printf("[%d, %f]\n", err, runtime);

  free(arr);
  free(prefixSum);

  return 0;
}
